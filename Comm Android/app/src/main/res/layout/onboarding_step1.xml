<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_glass"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_glass_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="start">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_step1_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_step1_body"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="start"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/onboarding_step_hint"
                android:id="@+id/hint1" />
            <include layout="@layout/onboarding_step_hint"
                android:id="@+id/hint2" />
            <include layout="@layout/onboarding_step_hint"
                android:id="@+id/hint3" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
